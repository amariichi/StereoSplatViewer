# Python artifacts
__pycache__/
*.pyc
.venv/
.env
*.egg-info/
third_party/

# Node artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Editor/OS
.DS_Store

# Backend data
backend/.data/*
